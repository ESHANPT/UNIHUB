# Copy this file to .env and fill in your own Supabase project values.
# Only public values belong here. Never add a service-role key to a Vite app.

# Project URL (the app strips a trailing /rest/v1 for you)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — safe for the browser, protected by RLS
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
